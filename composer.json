{
    "name": "laminas-api-tools/api-tools-hal",
    "description": "Laminas Module providing Hypermedia Application Language assets and rendering",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "api-tools",
        "module",
        "psr-13",
        "rest",
        "hal"
    ],
    "homepage": "https://api-tools.getlaminas.org",
    "support": {
        "docs": "https://api-tools.getlaminas.org/documentation",
        "issues": "https://github.com/laminas-api-tools/api-tools-hal/issues",
        "source": "https://github.com/laminas-api-tools/api-tools-hal",
        "rss": "https://github.com/laminas-api-tools/api-tools-hal/releases.atom",
        "chat": "https://laminas.dev/chat",
        "forum": "https://discourse.laminas.dev"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.99"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/package-versions-deprecated": true
        }
    },
    "extra": {
        "laminas": {
            "module": "Laminas\\ApiTools\\Hal"
        }
    },
    "require": {
        "container-interop/container-interop": "^1.2",
        "ext-json": "*",
        "laminas-api-tools/api-tools-api-problem": "^1.10",
        "laminas/laminas-eventmanager": "^3.15",
        "laminas/laminas-filter": "^2.42",
        "laminas/laminas-http": "^2.23",
        "laminas/laminas-hydrator": "^4.17",
        "laminas/laminas-modulemanager": "^2.19",
        "laminas/laminas-mvc": "^3.8",
        "laminas/laminas-paginator": "^2.21",
        "laminas/laminas-servicemanager": "^3.24",
        "laminas/laminas-stdlib": "^3.21",
        "laminas/laminas-uri": "^2.14",
        "laminas/laminas-view": "^2.43",
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/link": "^1.0 || ^2.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.1",
        "laminas/laminas-router": "^3.16",
        "phpdocumentor/reflection-docblock": "^5.2.2",
        "phpspec/prophecy-phpunit": "^2",
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
        "psalm/plugin-phpunit": "^0.19",
        "vimeo/psalm": "^6.14"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\ApiTools\\Hal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\ApiTools\\Hal\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-clover clover.xml",
        "static-analysis": "psalm --shepherd --stats --show-info=true"
    },
    "replace": {
        "zfcampus/zf-hal": "^1.6.0"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-api-problem"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/laminas-mvc"
        }
    ]
}
